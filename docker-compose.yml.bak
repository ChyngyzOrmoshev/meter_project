services:
  mongodb:
    image: mongo:7.0
    container_name: meters_db
    restart: always
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
      - ./backups:/backups
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4G
        reservations:
          cpus: '0.5'
          memory: 1G

  app:
    build: ./app
    container_name: meters_app
    restart: always
    depends_on:
      - mongodb
    ports:
      - "8501:8501"
    env_file:
      - ./app/cEnergo.env
    volumes:
      - ./Catalog.xlsx:/app/catalog.xlsx
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: streamlit run web_site.py --server.port=8501 --server.address=0.0.0.0
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4G
        reservations:
          cpus: '0.5'
          memory: 1G
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8501/_stcore/health" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  # РОБОТ АВТОМАТИЧЕСКОГО СБОРА ДАННЫХ ИЗ MS SQL
  sync-mssql:
    build: ./app
    container_name: meters_sync_mssql
    restart: always # <-- Если сервер упадет или перезагрузится, робот включится сам
    depends_on:
      - mongodb
    env_file:
      - ./app/cEnergo.env
    environment:
      - TZ=Asia/Bishkek
    volumes:
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: python sync_mssql.py # <-- Запускаем именно робота, а не сайт

  # РОБОТ АВТОМАТИЧЕСКОГО СБОРА ДАННЫХ С СЕРВЕРА SANXING
  sync-sanxing:
    build: ./app
    container_name: meters_sync_sanxing
    restart: always
    depends_on:
      - mongodb
    env_file:
      - ./app/cEnergo.env
    environment:
      - TZ=Asia/Bishkek
    volumes:
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: python sync_sanxing.py

  # РОБОТ АВТОМАТИЧЕСКОГО СБОРА ДАННЫХ С СЕРВЕРА SANRISE
  sync-sanrise:
    build: ./app
    container_name: meters_sync_sanrise
    restart: always
    depends_on:
      - mongodb
    env_file:
      - ./app/cEnergo.env
    environment:
      - TZ=Asia/Bishkek
    volumes:
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: python sync_sanrise.py

  # РОБОТ АВТОМАТИЧЕСКОГО СБОРА ДАННЫХ С СЕРВЕРА HEXING KUK
  sync-hexing-kuk:
    build: ./app
    container_name: meters_sync_hexing_kuk
    restart: always
    depends_on:
      - mongodb
    env_file:
      - ./app/cEnergo.env
    environment:
      - TZ=Asia/Bishkek
    volumes:
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: python sync_hexing_kuk.py

  # РОБОТ АВТОМАТИЧЕСКОГО СБОРА ДАННЫХ С СЕРВЕРА RiseSun
  sync-risesun:
    build: ./app
    container_name: meters_sync_risesun
    restart: always
    depends_on:
      - mongodb
    env_file:
      - ./app/cEnergo.env
    environment:
      - TZ=Asia/Bishkek
    volumes:
      - ./app:/app
      - ./app/odbcinst.ini:/etc/odbcinst.ini
      - ./logs:/app/logs
    command: python sync_risesun.py

  # ВЕБ-ИНТЕРФЕЙС ДЛЯ БРАУЗЕРА
  mongo-express:
    image: mongo-express:latest
    container_name: meters_web_admin
    restart: always
    ports:
      - "8081:8081"
    environment:
      - ME_CONFIG_MONGODB_SERVER=mongodb # Подключаемся к нашему контейнеру базы
      - ME_CONFIG_BASICAUTH_USERNAME=admin # Логин для входа в веб-панель
      - ME_CONFIG_BASICAUTH_PASSWORD=pass # Пароль для входа в веб-панель
    depends_on:
      - mongodb

volumes:
  mongo_data:
